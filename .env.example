# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL=postgresql://todo:todo@postgres:5432/todo
REDIS_URL=redis://redis:6379
NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:8080
# When using the Vite dev server (npm run dev -w frontend) set this to http://localhost:5173
COOKIE_SECURE=false
# Docker Compose only: REQUIRED password for the postgres container. No default.
# Generate one (URL-safe): node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=

# Settings for the end-to-end test stack only. The stack is thrown away after each run.
# Tests register a new user each, all from one IP, so the login rate limit is raised here.
# The default of 10 per minute stays in place everywhere else.
AUTH_RATE_LIMIT_MAX=1000
# Throwaway password for the disposable test database (not a real secret).
POSTGRES_PASSWORD=e2e-throwaway-password
